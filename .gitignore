# Self-contained big things live in the repo tree but never in git.
# The repo must stay clonable in seconds on a borrowed machine.

# downloaded model weights / projectors
models/

# self-downloaded runtimes (llama.cpp builds, OpenVINO, drivers)
bin/

# campaign working data: raw logs, corpora, screenshots, generated pages
# (** so the pattern still matches if a slug ever contains a slash)
results/**/data/
results/**/work/
*.log

# benchmark datasets and per-run outputs (harness re-downloads them)
scripts/bench/datasets/
scripts/bench/results/

# agentic benchmark (Pier / DeepSWE): vendored upstream clones, sandbox
# scratch, and per-run trajectories are all re-creatable. The setup notes
# and runner scripts in agentic/ ARE tracked.
agentic/deep-swe/
agentic/work/
agentic/pier/
agentic/trajectories/
agentic/results/
agentic/.venv/
agentic/**/.venv/
agentic/**/__pycache__/

# python / node debris
__pycache__/
node_modules/
.venv/

# agent-local state
.aider*
.qwen/
.claude/

# offline transfer bundle (built by scripts/make-offline-bundle.ps1)
offline-bundle/
