# Self-contained big things live in the repo tree but never in git.
# The repo must stay clonable in seconds on a borrowed machine.

# downloaded model weights / projectors
models/

# self-downloaded runtimes (llama.cpp builds, OpenVINO, drivers)
bin/

# CAMPAIGN RESULTS. Ignore bulk BY EXTENSION, or by a directory that holds
# ONLY bulk. Never ignore a directory of mixed content. results/**/data/ and
# results/**/work/ were ignored wholesale here under the comment "campaign
# working data"; they in fact hold the instruments (lib.ps1, judge.py, the six
# rule21-*.py, power-integrate.py, make-ladder-png.py's inputs) and the primary
# records (telemetry CSVs, power traces, per-arm JSON) that the published pages
# cite by name. See methodology/METHODOLOGY.md, "An ignore rule is a claim
# about re-creatability", and scripts/verify/instrument-guard.py, which fails
# if this is ever swallowed again.

# per-run server and harness transcripts - remade by re-running the harness
*.log

# opaque byte caches, not readings: llama-perplexity --kl-divergence-base
# logit dumps (25 GB of the 25 GB under results/), model shards, arrays
*.dat
*.bin
*.npy
*.npz
*.gguf
*.safetensors

# process debris
*.pid
*.pyc

# NAMED SCRATCH. Putting a file here is the declaration that it is
# re-creatable. Nothing a tracked file cites may live here.
**/scratch/
results/**/tmp/

# benchmark datasets and per-run outputs (harness re-downloads them)
scripts/bench/datasets/
scripts/bench/results/

# agentic benchmark (Pier / DeepSWE): vendored upstream clones, sandbox
# scratch, and per-run trajectories are all re-creatable. The setup notes
# and runner scripts in agentic/ ARE tracked.
agentic/deep-swe/
agentic/work/
agentic/pier/
agentic/trajectories/
agentic/results/
agentic/.venv/
agentic/**/.venv/
agentic/**/__pycache__/

# python / node debris
__pycache__/
node_modules/
.venv/

# agent-local state
.aider*
.qwen/
.claude/

# offline transfer bundle (built by scripts/make-offline-bundle.ps1)
offline-bundle/
